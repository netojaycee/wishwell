# Copy to .env.local for local dev. Local Postgres via DBngin needs no password;
# Neon connection strings need ?sslmode=require (the db client adds this automatically
# for any non-localhost URL: see src/db/index.ts).
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/wishwell_dev

BETTER_AUTH_SECRET=
# `pnpm dev` runs on a fixed port 3005 (see package.json) so these two never drift out
# of sync with whatever port Next actually bound to: keep them matching your dev port.
BETTER_AUTH_URL=http://localhost:3005
NEXT_PUBLIC_APP_URL=http://localhost:3005

# Google OAuth (optional: email/password works without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 (S3-compatible): media uploads (optional until wired)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Resend: invite emails, magic links (optional until wired; needs a verified domain for real delivery)
RESEND_API_KEY=

# Giphy: GIF picker on the post form (optional; free key at developers.giphy.com)
GIPHY_API_KEY=

# Analytics (optional). Vercel Web Analytics (page views) needs no key: enable it in the
# Vercel project's Analytics tab. PostHog powers the funnel events in src/lib/analytics.ts;
# with no key set, nothing is sent. Free project key at posthog.com.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Search engine ownership verification (optional): the content value of each meta tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Account that owns the example boards created by `pnpm db:seed-demo` (defaults to the
# founder email in src/db/seed-demo.ts).
EXAMPLE_OWNER_EMAIL=
